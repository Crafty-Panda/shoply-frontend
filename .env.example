# Copy to `.env` or `.env.local`. Never commit secrets.
#
# ⚠️ Vite exposes `VITE_*` vars in the client bundle. Use an Airtable token scoped
#    to read this base only, and rotate it if leaked.
VITE_AIRTABLE_TOKEN=
# Base ID from Airtable (e.g. appXXXXXXXXXXXXXX)
VITE_AIRTABLE_BASE_ID=
# Table name exactly as in Airtable (spaces ok)
VITE_AIRTABLE_TABLE_NAME=
# Alias for VITE_AIRTABLE_TOKEN (optional if TOKEN is set)
# VITE_AIRTABLE_API_KEY=
# Override API root only if proxied — default https://api.airtable.com/v0
# VITE_AIRTABLE_API_BASE=
